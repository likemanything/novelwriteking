# 复制为项目根目录的 .env.production（已被 .gitignore 忽略，切勿提交）
# 生成随机值：openssl rand -hex 24 / openssl rand -base64 32

# 域名（自动 HTTPS）；没有域名先填 :80
DOMAIN=write.example.com
# 对外访问地址，必须与浏览器里访问的一致
PUBLIC_URL=https://write.example.com

POSTGRES_PASSWORD=
INKLOOM_DB_PASSWORD=

SESSION_SECRET=
# 丢失后已保存的模型密钥无法解密，务必备份
MASTER_KEY=

SIGNUP_MODE=invite
ADMIN_PHONES=你的手机号

# 生产环境必须用阿里云短信
SMS_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
