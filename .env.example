# 墨织服务端配置。复制为 .env 后修改；开发环境可以运行 npm run setup 自动生成。
# 生产环境必须修改所有标注「必填」的项目，并妥善保管 MASTER_KEY（丢失后已保存的模型密钥无法解密）。

# 运行环境：development / production
NODE_ENV=development

# 监听地址与端口（生产环境放在反向代理后面时保持 127.0.0.1）
HOST=127.0.0.1
PORT=4318

# 对外访问地址（必填）。用于校验请求来源、生成邀请链接、决定 Cookie 是否只走 HTTPS
PUBLIC_URL=http://127.0.0.1:5173

# Postgres 连接串（必填）。应用账号不能是超级用户，否则行级安全隔离会失效
DATABASE_URL=postgres://inkloom:inkloom@127.0.0.1:54329/inkloom

# 会话与验证码签名密钥（必填，至少 32 个随机字符）
SESSION_SECRET=

# 模型密钥加密主密钥（必填，32 字节的 base64）。生成方法：openssl rand -base64 32
MASTER_KEY=

# 注册方式：invite（邀请制，需要邀请码或团队邀请链接）/ open（开放注册）
SIGNUP_MODE=invite

# 平台管理员手机号，多个用逗号分隔。这些号码无需邀请码即可注册，并可以管理内测邀请码
ADMIN_PHONES=13800000000

# 短信服务：console（开发用，验证码打印在服务端日志）/ aliyun（阿里云短信）
SMS_PROVIDER=console
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 部署在 Nginx 等反向代理后面时设为 true（用于识别真实客户端 IP 做限流）
TRUST_PROXY=false

# 是否允许模型接口地址指向内网（例如同一台服务器上的 Ollama）。公网部署请保持 false
ALLOW_PRIVATE_MODEL_HOSTS=false
